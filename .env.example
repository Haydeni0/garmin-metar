# Local development environment configuration
# Copy this file to .env and configure your values:
#   cp .env.example .env
#
# These values are automatically loaded into the Connect IQ simulator
# on debug launch (F5) via the preLaunchTask in .vscode/launch.json.

# AVWX API Token for real METAR/TAF weather queries.
# Get a free token at https://avwx.rest
# Set to MOCK_VFR or MOCK_IFR_LONG to test offline mock payloads without API usage.
AVWX_TOKEN=YOUR_TOKEN_HERE

# Default station displayed on app launch (ICAO code)
TARGET_STATION=EGWU

# Comma-separated list of airport ICAO codes for the station selection menu
STATION_LIST=EGWU,EGLL,EGUB,EGVO,KJFK,KLAX

# Seconds before app auto-exits to save battery (use 300+ for debugging)
AUTO_EXIT_SECONDS=30

# Optional simulated GPS coordinates for simulator testing (latitude,longitude)
# When set, nearby airports uses this location if watch GPS has no fix
SIMULATED_GPS=51.5147,-0.3046

# Number of nearby airport suggestions to show in the discovery menu (default 5)
NEARBY_COUNT=5
